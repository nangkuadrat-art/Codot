{
  "name": "docucollab-rkpd",
  "version": "1.0.0",
  "description": "Aplikasi Kolaboratif Multi-User Penyusunan Naskah RKPD dengan Kontrol Hak Akses per Bab",
  "main": "server/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server/index.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "build:client": "cd client && npm run build",
    "dev:server": "node server/index.js",
    "dev:client": "cd client && npm run dev"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "express": "^5.2.1",
    "mammoth": "^1.11.1",
    "multer": "^2.1.2"
  }
}
